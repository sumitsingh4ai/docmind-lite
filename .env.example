# Provider: "huggingface" (default, free) or "openai"
AI_PROVIDER=huggingface

# Hugging Face free inference (default)
OPENAI_API_KEY=hf_replace_me
OPENAI_BASE_URL=https://api-inference.huggingface.co
OPENAI_CHAT_MODEL=meta-llama/Llama-3.2-3B-Instruct
OPENAI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI (alternative)
# Set AI_PROVIDER=openai, use an OpenAI key, and uncomment the lines below.
# OPENAI_API_KEY=replace_me
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

JWT_SECRET=replace_with_at_least_32_random_characters
# JWT auth: set to true to require a Bearer token on /api (default: false = disabled for local dev)
JWT_ENABLED=false
JWT_DEFAULT_USER=1
DATABASE_URL=jdbc:mysql://localhost:3306/sumitdocmind?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
DATABASE_USERNAME=sumitdocmind
DATABASE_PASSWORD=sumitdocmind_local_password